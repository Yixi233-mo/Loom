{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom Shell",
  "version": "0.1.0",
  "identifier": "app.loom.shell",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Loom · 织巢",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Loom 织巢 — 跨端 Agent 工作台",
    "longDescription": "把 Windows / 平板 / 手机编织成一台电脑，把手边的 AI Agent 编织成一个团队。",
    "copyright": "© 2026 Loom",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}