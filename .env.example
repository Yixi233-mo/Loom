# Loom Hub 环境变量样例
# 复制为 .env 后填写；.env 不入库（已在 .gitignore）
# 轮换流程见 SECURITY.md

# ── 必填（生产） ──────────────────────────────────────

# WebSocket / 设备注册 HMAC 密钥
# 生产必须改为随机强口令（例如：openssl rand -hex 32）
# 仅开发可沿用 dev-secret；启动时若为默认值会告警
WS_SECRET=dev-secret

# OAuth token 签名密钥（HS256）
# 生产必须随机强口令；泄露可按 SECURITY.md 轮换
LOOM_AUTH_SECRET=change-me-in-production

# LLM API Key 加密主密钥（32 字节 urlsafe base64 或任意口令）
# 用于 llm.crypto.encrypt/decrypt 本地保管服务商 Key
LOOM_MASTER_KEY=change-me-master-key

# ── 可选 ─────────────────────────────────────────────

# 外部 Agent / Work Buddy
# LOOM_WORK_BUDDY_MCP=http://127.0.0.1:54916/mcp
# LOOM_WORK_BUDDY_TOKEN=
# LOOM_WORK_BUDDY_DOWNLOAD_URL=
# LOOM_WORK_BUDDY_TOOL=

# 模型服务（缺省时降级链走 Ollama / 规则兜底）
# DEEPSEEK_API_KEY=
# OPERIT_API_KEY=

# 运行
# LOOM_DATA_DIR=./data
# LOOM_LOG_DIR=./logs
# NETWORK_MODE=local
